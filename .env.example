# ── HILUXA Backend Ortam Değişkenleri (ŞABLON) ─────────────────────────
# Bu dosyayı ".env" olarak kopyalayın ve kendi değerlerinizi girin:
#   cp .env.example .env

# ── AI Sağlayıcı Seçimi ──
# "gemini"    → Google Gemini (ücretsiz katman, kredi kartı istemez)
# "anthropic" → Claude (kredi kartı/ücretli hesap gerektirir, daha güçlü)
AI_PROVIDER=gemini

# ── Google Gemini ── (ücretsiz anahtar: https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy_buraya_kendi_anahtariniz
GEMINI_MODEL=gemini-2.5-flash

# ── Anthropic Claude ── (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-buraya_kendi_anahtariniz
ANTHROPIC_MODEL=claude-sonnet-5

# ── Ortak AI Ayarları ──
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.85

# ── Sunucu portu (index.html içindeki BACKEND_URL ile eşleşmeli) ──
PORT=3000
FLASK_DEBUG=0
